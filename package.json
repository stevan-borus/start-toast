{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevan-borus/start-toast.git"
  },
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "build": "nx run-many --targets=build --exclude=examples/**",
    "build:all": "nx run-many --targets=build --exclude=examples/**",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm format",
    "clean": "find . -name 'dist' -type d -prune -exec rm -rf {} +",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf {} +",
    "clean:all": "pnpm run clean && pnpm run clean:node_modules",
    "format": "prettier --experimental-cli --ignore-unknown '**/*' --write",
    "lint": "nx run-many --target=test:eslint --exclude=examples/**",
    "lint:fix": "nx run-many --targets=lint:fix --exclude=examples/**",
    "test": "pnpm run test:ci",
    "test:ci": "nx run-many --targets=test:eslint,test:lib,test:types,build,test:publint",
    "test:eslint": "nx run-many --target=test:eslint --exclude=examples/**",
    "test:lib": "nx run-many --targets=test:lib --exclude=examples/**",
    "test:types": "nx run-many --targets=test:types --exclude=examples/**",
    "typecheck": "pnpm run test:types"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@tanstack/eslint-config": "0.4.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.10.6",
    "nx": "^23.0.0",
    "premove": "^4.0.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "tsdown": "^0.22.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "start-toast-core": "workspace:*",
    "react-start-toast": "workspace:*"
  },
  "pnpm": {
    "//": "Workspace-only pins — see examples/react/basic/KNOWN_ISSUES.md. Pins coherent 1.167.x versions of TSS internals so the example app's dev server boots; latest TSS has a plugin-core/server-core version skew that breaks `pnpm dev`. Production builds and the published lib are unaffected.",
    "overrides": {
      "@tanstack/start-plugin-core": "1.167.34",
      "@tanstack/start-server-core": "1.167.19",
      "@tanstack/start-client-core": "1.167.17"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "unrs-resolver"
    ]
  }
}
