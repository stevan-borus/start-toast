{
  "name": "react-start-toast",
  "version": "0.1.0",
  "description": "Server-set toast notifications for TanStack Start. A 1:1 adaptation of remix-toast for TSS server fns and h3 cookies.",
  "author": "Stevan Borus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevan-borus/start-toast.git",
    "directory": "packages/react-start-toast"
  },
  "homepage": "https://github.com/stevan-borus/start-toast",
  "keywords": [
    "tanstack",
    "tanstack-start",
    "react",
    "toast",
    "flash",
    "cookie",
    "remix-toast"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint:fix": "pnpm -w exec eslint \"$INIT_CWD/src\" --fix",
    "test:eslint": "pnpm -w exec eslint \"$INIT_CWD/src\"",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "test:publint": "publint",
    "build": "tsdown"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "iron-webcrypto": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "start-toast-core": "workspace:*",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.167.0",
    "@tanstack/react-start": ">=1.167.0",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
