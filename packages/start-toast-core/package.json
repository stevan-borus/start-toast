{
  "name": "start-toast-core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic primitives for server-set flash toasts. Bundled into react-start-toast and any future framework adapters; not published independently.",
  "author": "Stevan Borus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevan-borus/start-toast.git",
    "directory": "packages/start-toast-core"
  },
  "homepage": "https://github.com/stevan-borus/start-toast",
  "keywords": [
    "tanstack",
    "tanstack-start",
    "toast",
    "flash",
    "cookie",
    "remix-toast"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint:fix": "eslint ./src --fix",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "src"
  ],
  "dependencies": {
    "iron-webcrypto": "^2.0.0",
    "zod": "^4.0.0"
  }
}
